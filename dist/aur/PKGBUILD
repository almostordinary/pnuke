pkgname=pnuke-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="The sub-millisecond port killer and listener cockpit for developers"
arch=('x86_64' 'aarch64')
url="https://github.com/almostordinary/pnuke"
license=('MIT' 'Apache-2.0')
provides=('pnuke')
conflicts=('pnuke')

source_x86_64=("https://github.com/almostordinary/pnuke/releases/download/v${pkgver}/pnuke-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("https://github.com/almostordinary/pnuke/releases/download/v${pkgver}/pnuke-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${srcdir}/pnuke" "${pkgdir}/usr/bin/pnuke"
}
